{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,

    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],

    "module": "ESNext",
    "moduleResolution": "Bundler",

    "jsx": "react-jsx",

    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,

    "types": [
      "node",
      "vite/client"
    ]
  },

  "include": [
    "src",
    "forge.config.ts",
    "vite.*.config.ts"
  ],

  "exclude": [
    "node_modules",
    ".vite",
    "out"
  ]
}